# LIFELINE OS — ENVIRONMENT CONFIGURATION TEMPLATE

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Optional: Google Gemini API Key for AI Copilot Briefings
# Leave blank to run in deterministic offline mode with pre-calibrated EOC responses
GEMINI_API_KEY=

# Public Two-Way Smartphone Hardware Broadcast Topic
# Presenters/Judges subscribe to this topic on the free 'ntfy' app (iOS/Android/Web)
VITE_NTFY_TOPIC=lifeline-os-alert-2026

# Nominatim User-Agent identifier for open geocoding
VITE_GEOCODING_USER_AGENT=LifelineOS-DisasterEOC/1.0
